{
  "name": "wink-g2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --outDir ../public/g2 --emptyOutDir",
    "pack": "npm run build && mkdir -p ../release && evenhub pack app.json dist -o ../release/wink.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173 --automation-port 9898"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
